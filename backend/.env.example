# Copy this file to .env and fill in your own values.
PORT=3000

# PostgreSQL connection (the database you created in pgAdmin 4)
PGHOST=localhost
PGPORT=5432
PGDATABASE=fintrack
# The website logs in as fintrack_app, a role with only the rights it needs (database/06_roles.sql).
PGUSER=fintrack_app
PGPASSWORD=fintrack_app_local

# The admin account. Only `npm test` uses it, to rebuild the test database.
PGADMIN_USER=postgres
PGADMIN_PASSWORD=your_postgres_password

# Database used by `npm test`. It is wiped and rebuilt on every test run,
# so its name must end in _test and it must never be your real database.
TEST_PGDATABASE=fintrack_test

# Any long random string, used to sign login tokens
JWT_SECRET=change_me_to_a_long_random_string

# ---- Online only (Render etc.); leave these out on your laptop ----
# One line instead of PGHOST ... PGPASSWORD, as printed by backend/bin/install-db.php:
# DATABASE_URL=postgresql://fintrack_app:<password>@<host>/<db>?sslmode=require
# The header the hosting proxy puts the visitor's real IP in (Render: True-Client-IP):
# CLIENT_IP_HEADER=True-Client-IP
# Addresses allowed to call the API from another origin (the Android app):
# CORS_ORIGINS=https://localhost,capacitor://localhost
