# Copy this file to .env and fill in your own values.
PORT=3000

# PostgreSQL connection (the database you created in pgAdmin 4)
PGHOST=localhost
PGPORT=5432
PGDATABASE=fintrack
PGUSER=postgres
PGPASSWORD=your_postgres_password

# Database used by `npm test`. It is wiped and rebuilt on every test run,
# so its name must end in _test and it must never be your real database.
TEST_PGDATABASE=fintrack_test

# Any long random string, used to sign login tokens
JWT_SECRET=change_me_to_a_long_random_string
